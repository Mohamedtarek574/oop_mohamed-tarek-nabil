package javaapplication169;

import java.util.Scanner;


public class JavaApplication169 {

    
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int num = input.nextInt();
        int max =0;

        while (num != 0) {
            if (num > max) {
                max = num;
            }
            num = input.nextInt();
        }

        System.out.println(max);
    }
}

